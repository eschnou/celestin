# Copy to .env and fill in. .env is gitignored.
# The AI provider (specs 013, 014). Optional: without a key the app starts and an administrator chooses the
# provider and pastes its key in the settings screen (needs SECRETS_DIR); a variable set here is the one in
# force and its field in the settings is read-only. OpenAI by default; for another provider set the address and
# the models, e.g. Groq:
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_MODEL=qwen/qwen3.8-27b          # the tutor
#   AUTHORING_MODEL=openai/gpt-oss-120b
#   TRANSCRIPTION_MODEL=qwen/qwen3.8-27b   # must accept images
# A local Ollama needs no key: OPENAI_BASE_URL=http://localhost:11434/v1 and AI_API_STYLE=chat (or responses).
# Full list and what was verified: documentation/ai-providers.md.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_API_STYLE=responses
# AI_STRUCTURED_OUTPUTS=schema
# The learner's clock, for greetings. Defaults to Europe/Brussels.
# TIMEZONE=Europe/Brussels

# Accounts (spec 004). A long random string; sessions are unusable without it, unless SECRETS_DIR is set.
SESSION_SECRET=
# Spec 013: where session_secret and encryption_key are generated on first boot (and read afterwards).
# SECRETS_DIR=./data/secrets
# The session cookie is Secure by default; false for http://localhost, or auto: Secure only over HTTPS.
COOKIE_SECURE=false
# Who may create an account (spec 012): open (default), closed (no sign-up at all), or
# verification (sign-up, but an admin enables the account before its first sign-in).
# REGISTRATION_MODE=open
# SQLite by default, relative to backend/. Run `uv run alembic upgrade head` once.
# DATABASE_URL=sqlite:///./data/celestin.db

# Courses and chapters (spec 005). Defaults shown.
# CHAPTER_TEXT_MIN_CHARS=300
# CHAPTER_TEXT_MAX_CHARS=100000
# PACK_MAX_CHARS=60000
# MAX_COURSES_PER_STUDENT=30
# MAX_CHAPTERS_PER_COURSE=40

# Discussion mode (spec 007). A conversation is stored whole, so it is capped;
# whichever limit is crossed first closes it and the student opens a new one.
# DISCUSSION_MAX_ENTRIES=400
# DISCUSSION_MAX_CHARS=200000
# DISCUSSION_CONVERSATIONS_PER_DAY=30

# Authoring agent (spec 005). Defaults shown; prices are USD per million tokens.
# AUTHORING_MODEL=gpt-6.1-sol
# AUTHORING_REASONING_EFFORT=medium
# AUTHORING_MAX_OUTPUT_TOKENS=32000
# AUTHORING_MAX_REPAIRS=2
# AUTHORING_TIMEOUT_S=900
# AUTHORING_CALL_TIMEOUT_S=300
# AUTHORING_CONCURRENT_PER_STUDENT=2
# AUTHORING_RUNS_PER_DAY=20
# AUTHORING_MAX_CONCURRENT=4

# Documents and transcription (spec 006). Defaults shown.
# DOCUMENT_MAX_BYTES=26214400
# DOCUMENT_MAX_PAGES=50
# DOCUMENT_MIN_PIXELS=800
# TRANSCRIPTION_MODEL=gpt-6.1-sol
# TRANSCRIPTION_DETAIL=high
# TRANSCRIPTION_DPI=150
# TRANSCRIPTION_MAX_SIDE_PX=1800
# TRANSCRIPTION_BATCH_PAGES=2
# TRANSCRIPTION_CONCURRENCY=4
# TRANSCRIPTION_VERIFY_HANDWRITING=false
