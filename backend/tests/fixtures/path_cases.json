{
  "_comment": "Shared by backend tests/unit/test_path.py and frontend lib/tutor/__tests__/path.test.ts. Sections are in chapter order. Spec 019: no section is locked; `available` is the one Célestin proposes (the first that is neither done, skipped nor active, only when nothing is active); `next` is that same section's id, or the first neither done, skipped nor active when one is active, or null; the page-turn button (`path.page_turn`) proposes `next` only when nothing is active, the `available` section.",
  "sections": ["sa", "sb", "sc", "sd"],
  "cases": [
    {"name": "empty", "progress": {"done": [], "active": null, "skipped": []},
     "states": {"sa": "available", "sb": "open", "sc": "open", "sd": "open"}, "next": "sa"},
    {"name": "first active", "progress": {"done": [], "active": "sa", "skipped": []},
     "states": {"sa": "active", "sb": "open", "sc": "open", "sd": "open"}, "next": "sb"},
    {"name": "mid-chapter with active", "progress": {"done": ["sa"], "active": "sb", "skipped": []},
     "states": {"sa": "done", "sb": "active", "sc": "open", "sd": "open"}, "next": "sc"},
    {"name": "mid-chapter without active", "progress": {"done": ["sa", "sb"], "active": null, "skipped": []},
     "states": {"sa": "done", "sb": "done", "sc": "available", "sd": "open"}, "next": "sc"},
    {"name": "gap is the available one", "progress": {"done": ["sa", "sc"], "active": null, "skipped": []},
     "states": {"sa": "done", "sb": "available", "sc": "done", "sd": "open"}, "next": "sb"},
    {"name": "jumped ahead: the active one is out of order", "progress": {"done": ["sa"], "active": "sd", "skipped": []},
     "states": {"sa": "done", "sb": "open", "sc": "open", "sd": "active"}, "next": "sb"},
    {"name": "a skipped section is never the available one", "progress": {"done": ["sa"], "active": null, "skipped": ["sb"]},
     "states": {"sa": "done", "sb": "skipped", "sc": "available", "sd": "open"}, "next": "sc"},
    {"name": "skipped first sections", "progress": {"done": [], "active": null, "skipped": ["sa", "sb"]},
     "states": {"sa": "skipped", "sb": "skipped", "sc": "available", "sd": "open"}, "next": "sc"},
    {"name": "skipped with an active one", "progress": {"done": [], "active": "sc", "skipped": ["sa"]},
     "states": {"sa": "skipped", "sb": "open", "sc": "active", "sd": "open"}, "next": "sb"},
    {"name": "last active", "progress": {"done": ["sa", "sb", "sc"], "active": "sd", "skipped": []},
     "states": {"sa": "done", "sb": "done", "sc": "done", "sd": "active"}, "next": null},
    {"name": "complete", "progress": {"done": ["sa", "sb", "sc", "sd"], "active": null, "skipped": []},
     "states": {"sa": "done", "sb": "done", "sc": "done", "sd": "done"}, "next": null},
    {"name": "finished with skipped sections", "progress": {"done": ["sa", "sc"], "active": null, "skipped": ["sb", "sd"]},
     "states": {"sa": "done", "sb": "skipped", "sc": "done", "sd": "skipped"}, "next": null},
    {"name": "everything skipped", "progress": {"done": [], "active": null, "skipped": ["sa", "sb", "sc", "sd"]},
     "states": {"sa": "skipped", "sb": "skipped", "sc": "skipped", "sd": "skipped"}, "next": null}
  ]
}
